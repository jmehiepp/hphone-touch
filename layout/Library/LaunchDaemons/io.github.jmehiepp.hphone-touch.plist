<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>io.github.jmehiepp.hphone-touch</string>
<key>ProgramArguments</key><array><string>/usr/bin/hphone-touchd</string></array>
<key>UserName</key><string>mobile</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>ProcessType</key><string>Interactive</string>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>/var/mobile</string></dict>
</dict></plist>
